{
  "about": "Text helpers from util.lua. fn names are the Lua's; input is a record of its arguments (utf8_codepoint takes a character index from 0, not a byte offset; is_ideographic and is_punct map over `cps`). new_id is random and has no vectors.",
  "cases": [
    {
      "expect": "padded",
      "fn": "trim",
      "input": {
        "s": "  padded \n"
      },
      "name": "trim: strips both ends"
    },
    {
      "expect": "",
      "fn": "trim",
      "input": {
        "s": ""
      },
      "name": "trim: empty stays empty"
    },
    {
      "expect": "",
      "fn": "trim",
      "input": {
        "s": "   \t "
      },
      "name": "trim: only spaces"
    },
    {
      "expect": "x y",
      "fn": "trim",
      "input": {
        "s": "\t\u000b\u000c\r x y \r\n"
      },
      "name": "trim: every ASCII space character"
    },
    {
      "expect": "two  words",
      "fn": "trim",
      "input": {
        "s": "  two  words  "
      },
      "name": "trim: inner spaces kept"
    },
    {
      "expect": "　全角　",
      "fn": "trim",
      "input": {
        "s": "　全角　"
      },
      "name": "trim: an ideographic space is not ASCII whitespace"
    },
    {
      "expect": " nbsp ",
      "fn": "trim",
      "input": {
        "s": " nbsp "
      },
      "name": "trim: nor is a no-break space"
    },
    {
      "expect": " Hello  world",
      "fn": "strip_tags",
      "input": {
        "s": "<|emotion:awe|> Hello <|prosody:pause|> world"
      },
      "name": "strip_tags: between words"
    },
    {
      "expect": "Hello",
      "fn": "strip_tags",
      "input": {
        "s": "<|emotion:happy|>Hello"
      },
      "name": "strip_tags: at the start"
    },
    {
      "expect": "Haha, that was fun.",
      "fn": "strip_tags",
      "input": {
        "s": "<|sfx:laughter|>Haha, that was fun."
      },
      "name": "strip_tags: a sound effect before a word"
    },
    {
      "expect": "a  b  c",
      "fn": "strip_tags",
      "input": {
        "s": "a <|x|> b <|y|> c"
      },
      "name": "strip_tags: shortest match each time"
    },
    {
      "expect": "<|unclosed tag",
      "fn": "strip_tags",
      "input": {
        "s": "<|unclosed tag"
      },
      "name": "strip_tags: an unclosed tag stays"
    },
    {
      "expect": "<b>bold</b>",
      "fn": "strip_tags",
      "input": {
        "s": "<b>bold</b>"
      },
      "name": "strip_tags: HTML is not a tag"
    },
    {
      "expect": "xy",
      "fn": "strip_tags",
      "input": {
        "s": "x<||>y"
      },
      "name": "strip_tags: an empty tag"
    },
    {
      "expect": "z",
      "fn": "strip_tags",
      "input": {
        "s": "<|a|b|>z"
      },
      "name": "strip_tags: a bar inside a tag"
    },
    {
      "expect": "after",
      "fn": "strip_tags",
      "input": {
        "s": "<|a\nb|>after"
      },
      "name": "strip_tags: across a line break"
    },
    {
      "expect": "你好世界",
      "fn": "strip_tags",
      "input": {
        "s": "你好<|emotion:joy|>世界"
      },
      "name": "strip_tags: Chinese around a tag"
    },
    {
      "expect": 3,
      "fn": "word_count",
      "input": {
        "s": "<|emotion:awe|> Hello there world"
      },
      "name": "word_count: ignores tags"
    },
    {
      "expect": 0,
      "fn": "word_count",
      "input": {
        "s": ""
      },
      "name": "word_count: empty"
    },
    {
      "expect": 0,
      "fn": "word_count",
      "input": {
        "s": "  \n\t "
      },
      "name": "word_count: only spaces"
    },
    {
      "expect": 4,
      "fn": "word_count",
      "input": {
        "s": "a\tb\nc  d"
      },
      "name": "word_count: tabs and line breaks separate"
